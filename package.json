{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "build": "bun --bun node_modules/vite/bin/vite.js build",
    "preview": "bun --bun node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist server.js",
    "lint": "bun node_modules/typescript/bin/tsc --noEmit && bun scripts/check-localization.ts",
    "provision:admin": "bun scripts/provision-admin.ts",
    "reset:admin-password": "bun scripts/reset-admin-password.ts",
    "db:migrate:dev": "bun scripts/migrate-dev.ts",
    "test": "bun test",
    "test:preview": "bash scripts/smoke-preview.sh",
    "test:production": "bash scripts/smoke-production.sh",
    "test:auth": "bun test server/telegramAuth.test.ts",
    "test:excel": "bun test src/utils/excel.test.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie": "^2.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "happy-dom": "^21.0.4",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
